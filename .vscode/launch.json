{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VouchNest Server (Port 3000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "running on http://0.0.0.0:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
