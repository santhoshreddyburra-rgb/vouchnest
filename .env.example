# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RAZORPAY PAYMENT GATEWAY CONFIGURATION (Get free Test Keys from https://dashboard.razorpay.com):
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"

# FIREBASE DATABASE CONFIGURATION (Loaded automatically from firebase-applet-config.json, or via env vars):
FIREBASE_PROJECT_ID="divine-tempo-v3skh"
FIREBASE_API_KEY="AIzaSyBBTqCWbV9eVu63T-4GTXwVY9LKf133Mgw"
FIREBASE_DATABASE_ID="ai-studio-remixremixremixv-b54ad63f-9eb4-4ea2-b9a7-37a5cacda4a5"
FIREBASE_AUTH_DOMAIN="divine-tempo-v3skh.firebaseapp.com"
FIREBASE_APP_ID="1:1077699349768:web:e2e780a49e5b63cf75f0bd"

# To deliver real OTP verification emails to Gmail inboxes:
# Option 1: Gmail SMTP with Google App Password
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option 2: Generic SMTP provider (e.g. SendGrid, Mailgun, Amazon SES, Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"
SMTP_FROM='"VouchNest Security" <no-reply@vouchnest.com>'

# MOBILE SMS GATEWAY CONFIGURATION (Optional for live SMS delivery to phones):
# Option 1: Twilio SMS (Global)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# Option 2: Fast2SMS (India 10-digit mobile numbers)
FAST2SMS_API_KEY="your_fast2sms_api_key"

# Option 3: Custom SMS Gateway HTTP Webhook
SMS_GATEWAY_URL="https://your-sms-api.com/send"
SMS_GATEWAY_TOKEN="your_gateway_token"

