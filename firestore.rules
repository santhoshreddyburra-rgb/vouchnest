rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'santhoshreddyburra@gmail.com' ||
        request.auth.token.email == 'admin@vouchnest.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // TEST CONNECTION
    match /test/{testId} {
      allow read: if true;
    }

    // PUBLIC COUPONS CATALOG
    // Public read and write for coupons catalog and administrator publishing
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // BRANDS CATALOG
    // Public read for brand listings; writes restricted to Administrators
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // USER PROFILES
    // Public registration allowed; reads, writes, and cleanup allowed for user profiles
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    // CLAIMS / REDEEMED VOUCHERS
    match /claims/{claimId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // SAVED COUPONS / WISHLIST
    match /saved_coupons/{savedId} {
      allow read, write: if true;
    }

    // METADATA
    match /metadata/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

